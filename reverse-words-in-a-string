class Solution {
    public char[] reverse(char[] ch,int st,int l){
        while(st<l){
            char tem = ch[st];
            ch[st] = ch[l];
            ch[l] = tem;
            st++;
            l--;
        }
        return ch;
    }
    public String reverseWords(String s) {
        s = s.trim().replaceAll("\\s+"," ");
        char[] ch = s.toCharArray();
        int n = ch.length;
        reverse(ch,0,n-1);
        int st = 0;
        for(int i=0;i<n;i++){
            if(ch[i]==' '){
                reverse(ch,st,i-1);
                st = i+1;
            }
            if(i==n-1){
                reverse(ch,st,i);
            }
        }
        String str = new String(ch);
        return str;
    }
}
