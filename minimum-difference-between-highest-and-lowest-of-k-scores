import java.util.*;
class Solution {
    public int minimumDifference(int[] nums, int k) {
        if(k==1){
            return 0;
        }
        Arrays.sort(nums);
        int min = Integer.MAX_VALUE;
        int i = 0;
        while(i<nums.length && i+k-1<nums.length){
            int diff = nums[i+k-1] - nums[i];
            min = Math.min(diff,min);
            i++;
        }
        return min;
    }
}
