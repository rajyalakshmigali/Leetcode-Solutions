import java.util.*;
class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n = s.length();
        HashMap<Character,Integer> hm = new LinkedHashMap<>();
        int i=0,j=0;
        int max = 0;
        while(j<n){
            if(hm.containsKey(s.charAt(j))){
                hm.remove(s.charAt(i));
                i++;
            }else{
                hm.put(s.charAt(j),1);
                j++;
                max = Math.max(max,hm.size());
            }
        }
        return max;
    }
}
