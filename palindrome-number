class Solution {
    public boolean isPalindrome(int x) {
        int a = x;
        int rev = 0;
        while(x>0){
            int ele = x%10;
            rev = rev*10+ele;
            x = x/10;
        }
        if(a==rev){
            return true;
        }else{
            return false;
        }
    }
}
