class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;
        String str = "";
        for(int i=0;i<n;i++){
            str = str+digits[i];
        }
        int num = Integer.parseInt(str);
        num = num+1;
        int j = 0;
        int n1 = num;
        while(n1>0){
            j = j+1;
            n1 = n1/10;
        }
        int[] arr = new int[j];
        int i = j-1;
        while(num>0 && i>=0){
            arr[i] = num%10;
            num = num/10;
            i--;
        }
        return arr;
    }
}
