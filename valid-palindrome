class Solution {
    public boolean isPalindrome(String s) {
        if(s.matches(".*[^a-zA-Z0-9].*")){
            s = s.replaceAll("[^a-zA-Z0-9]","");
        }
        s = s.toLowerCase();
        int n = s.length();
        int st = 0,l = n-1;
        while(st<l){
            if(s.charAt(st)!=s.charAt(l)){
                return false;
            }
            st++;l--;
        }
        return true;
    }
}
